<mxfile host="app.diagrams.net">
  <diagram name="Architektura + hooki">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="MP Service Suite — architektura 3 wtyczek i kontrakt hooków (MP_CONTRACT_VERSION = 1)" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Jedyny kanał między wtyczkami = hooki mp_* (skalary/tablice, nigdy obiekty). Zakaz dotykania cudzych tabel (linter CI). Brak brata = tryb degraded, nigdy Fatal." style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="52" width="1000" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="actorK" value="KLIENT&#10;(formularz + panel)" style="shape=umlActor;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="120" y="170" width="50" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="actorP" value="PERSONEL&#10;(admin / koordynator / pracownik)" style="shape=umlActor;html=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="940" y="170" width="50" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="C" value="C — mp-service-intake&#10;(Zgłoszenia / SPRAWY)&#10;&#10;• formularz, walidacja, weryfikacja e-mail&#10;• numer SRV, panel klienta, RODO&#10;• oś zdarzeń sprawy (append-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="260" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="B" value="B — mp-warranty-registry&#10;(Rejestr GWARANCJI)&#10;&#10;• serial / produkt / data zakupu&#10;• import CSV, wyjątki gwarancyjne&#10;• status gwarancji (wyliczany)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="440" width="260" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="D" value="D — mp-workflow-automator&#10;(AUTOMATOR / reguły)&#10;&#10;• silnik reguł, auto-przydział&#10;• SLA + eskalacje, szablony maili&#10;• checklisty, eksport CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="440" width="260" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="eKC" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="actorK" target="C">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ePC" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="actorP" target="C">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eCD" value="①" style="endArrow=block;html=1;fontSize=14;fontStyle=1;strokeColor=#6c8ebf;exitX=0.65;exitY=1;entryX=0.45;entryY=0;curved=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="C" target="D">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eDC" value="②" style="endArrow=block;html=1;fontSize=14;fontStyle=1;strokeColor=#d79b00;exitX=0.5;exitY=0;entryX=0.9;entryY=1;curved=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="D" target="C">
