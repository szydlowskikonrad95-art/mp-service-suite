        <mxCell id="eBC" value="③" style="endArrow=block;html=1;fontSize=14;fontStyle=1;strokeColor=#82b366;exitX=0.6;exitY=0;entryX=0.1;entryY=1;curved=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B" target="C">
