        <mxCell id="eCB" value="④" style="endArrow=block;html=1;fontSize=14;fontStyle=1;strokeColor=#6c8ebf;exitX=0.35;exitY=1;entryX=0.9;entryY=0;curved=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="C" target="B">
          <mxGeometry relative="1" as="geometry"/>
