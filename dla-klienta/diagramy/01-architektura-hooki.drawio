        <mxCell id="eErase" value="⑤" style="endArrow=block;html=1;fontSize=14;fontStyle=1;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B" target="D">
          <mxGeometry relative="1" as="geometry">
