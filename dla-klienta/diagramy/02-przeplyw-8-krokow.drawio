<mxfile host="app.diagrams.net">
  <diagram name="Przepływ 8 kroków">
    <mxGraphModel dx="900" dy="624" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Przepływ sprawy serwisowej — 8 kroków kartki klienta" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="920" height="30" as="geometry"/></mxCell>
        <mxCell id="lg" value="Kolor = właściciel:  ■ C intake  ■ B gwarancje  ■ D automator" style="text;html=1;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="920" height="20" as="geometry"/></mxCell>

        <mxCell id="s1" value="KROK 1 — Klient wybiera RODZAJ i wypełnia formularz&#10;(pola zależne od kategorii; blok/shortcode na auto-stronie)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="440" height="55" as="geometry"/></mxCell>
        <mxCell id="s2" value="KROK 2 — Walidacja: kompletność + typy załączników + duplikat&#10;(dedup 15 min + rate-limit; honeypot/pułapka czasu; odmowa = zero eventów)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="175" width="440" height="55" as="geometry"/></mxCell>
        <mxCell id="mv" value="Weryfikacja e-mail (anty-spam): sprawa powstaje jako UNVERIFIED — status = NULL, BEZ eventów.&#10;Magic-link (token 1×, TTL 24h, potwierdzenie POST nie GET). Sieroty &gt;72h kasuje cron." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=2;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="248" width="440" height="46" as="geometry"/></mxCell>
        <mxCell id="s3" value="KROK 3 — Rejestr gwarancji weryfikuje serial / produkt / datę zakupu&#10;(snapshot gwarancji ZAMROŻONY na chwilę zgłoszenia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="312" width="440" height="55" as="geometry"/></mxCell>
        <mxCell id="s4" value="KROK 4 — Sprawa z numerem SRV + termin pierwszej reakcji&#10;NULL→'nowe' ATOMOWO przy potwierdzeniu; event CASE_CREATED (nie status_changed);&#10;status_changed_at = start zegara SLA; D zakłada wiersz case_sla na mp_case_created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="385" width="440" height="92" as="geometry"/></mxCell>
        <mxCell id="s5" value="KROK 5 — Silnik reguł nadaje PRIORYTET i PRZYDZIELA pracownika&#10;(round-robin / reguły; event CASE_ASSIGNED — każdy przydział)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="495" width="440" height="55" as="geometry"/></mxCell>
        <mxCell id="s6" value="KROK 6 — Klient dostaje POTWIERDZENIE (2. mail z SRV) + podgląd statusu&#10;(panel klienta: tylko WŁASNE sprawy — IDOR-safe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="568" width="440" height="55" as="geometry"/></mxCell>
        <mxCell id="s7" value="KROK 7 — Pracownik realizuje CHECKLISTĘ; każda decyzja w historii&#10;zmiana statusu WYŁĄCZNIE mp_case_change_status (optimistic-lock; UPDATE+event 1 transakcja)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="641" width="440" height="55" as="geometry"/></mxCell>
        <mxCell id="s8" value="KROK 8 — Przypomnienia + ESKALACJE SLA, a po zamknięciu RAPORT KOŃCOWY&#10;(sweep D → mp_sla_notified → eventy SLA_* na osi; raport = mp_case_add_system_message + mail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="714" width="440" height="78" as="geometry"/></mxCell>

        <mxCell id="a1" style="endArrow=block;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="endArrow=block;html=1;" edge="1" parent="1" source="s2" target="mv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="endArrow=block;html=1;" edge="1" parent="1" source="mv" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="endArrow=block;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" style="endArrow=block;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" style="endArrow=block;html=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" style="endArrow=block;html=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" style="endArrow=block;html=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
